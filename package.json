{
  "name": "xantoom.dev",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "check": "astro sync && tsc --noEmit --runExternalCode",
    "lint": "bunx bun@canary lint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify": "bun run fmt:check && bun run lint && bun run check && bun run build",
    "deploy": "astro build && wrangler deploy",
    "new-post": "bun scripts/new-post.ts",
    "postinstall": "xantoom-design sync"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "sharp": "^0.35.5",
    "xantoom-design": "github:Xantoom/xantoom-design#v0.2.2"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.3",
    "@astrojs/ts-content-mapper": "0.2.0",
    "@fontsource/inter": "^5.3.0",
    "@iconify-json/circle-flags": "^1.2.14",
    "@iconify-json/lucide": "^1.2.157",
    "@iconify-json/simple-icons": "^1.2.103",
    "@iconify/utils": "^3.1.7",
    "oxfmt": "^0.79.0",
    "satori": "^0.63.2",
    "typescript": "7.1.0-beta",
    "wrangler": "^4.165.0"
  }
}
