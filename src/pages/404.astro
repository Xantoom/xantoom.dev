---
import Icon from "~/components/Icon.astro";
import { homePath, localePath } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

const fr = useTranslations("fr");
const en = useTranslations("en");
---

<BaseLayout title={fr("404.title")} description={fr("404.text")} locale="fr" noindex>
  <div class="container wrap">
    <p class="code" aria-hidden="true">
      404
    </p>
    <h1>{fr("404.title")}</h1>
    <p>{fr("404.text")}</p>
    <p lang="en" class="en">
      {en("404.text")}
    </p>
    <div class="actions">
      <a class="primary" href={homePath("fr")}>
        <Icon name="arrow-left" size={16} />
        {fr("404.home")}
      </a>
      <a href={localePath("fr", "blog")}>{fr("nav.blog")}</a>
      <a href={localePath("fr", "projects")}>{fr("nav.projects")}</a>
      <a href={homePath("en")} lang="en">
        <Icon name="flag:gb" size={16} />
        {en("404.home")}
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-block: clamp(4rem, 12vw, 9rem);
    text-align: center;
  }

  .code {
    font-family: var(--x-font-mono);
    font-size: clamp(4rem, 12vw, 6.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--x-fg-faint);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  p {
    margin-top: 0.5rem;
    color: var(--x-fg-muted);
  }

  .en {
    color: var(--x-fg-faint);
  }

  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 2rem;

    & a {
      display: inline-flex;
      align-items: center;
      gap: 0.4375rem;
      height: 2.5rem;
      padding-inline: 1rem;
      border-radius: var(--x-radius-sm);
      border: 1px solid var(--x-line-strong);
      background: var(--x-surface);
      text-decoration: none;
      font-weight: 550;
      font-size: 0.9375rem;
      transition:
        background-color var(--x-duration-fast) var(--x-ease-out),
        border-color var(--x-duration-fast) var(--x-ease-out),
        opacity var(--x-duration-fast) var(--x-ease-out);

      &:hover {
        background: var(--x-raised);
        border-color: var(--x-fg-faint);
      }
    }

    & .primary {
      background: var(--x-fg);
      border-color: var(--x-fg);
      color: var(--x-bg);

      &:hover {
        background: var(--x-fg);
        border-color: var(--x-fg);
        opacity: 0.88;
      }
    }
  }
</style>
