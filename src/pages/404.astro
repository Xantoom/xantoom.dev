---
import Icon from "~/components/Icon.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas." locale="fr" noindex>
  <div class="container wrap">
    <p class="code" aria-hidden="true">
      404
    </p>
    <h1>Page introuvable</h1>
    <p>Cette page n'existe pas ou a été déplacée.</p>
    <p lang="en" class="en">
      This page doesn't exist or has moved.
    </p>
    <div class="actions">
      <a href="/">
        <Icon name="arrow-left" size={16} />
        Accueil
      </a>
      <a href="/en/" lang="en">
        Home (English)
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-block: clamp(4rem, 12vw, 10rem);
    text-align: center;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 16vw, 9rem);
    font-weight: 850;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--fg);

    &::after {
      content: "";
      display: block;
      width: 4.5rem;
      height: 0.375rem;
      margin: 1rem auto 0;
      border-radius: 6px;
      background: var(--brand-gradient);
    }
  }

  h1 {
    margin-top: 0.75rem;
    font-size: 1.75rem;
  }

  p {
    margin-top: 0.5rem;
    color: var(--fg-muted);
  }

  .en {
    color: var(--fg-faint);
  }

  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 2rem;

    & a {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      height: 2.5rem;
      padding-inline: 1rem;
      border-radius: 999px;
      border: 1px solid var(--line-strong);
      text-decoration: none;
      font-weight: 600;

      &:hover {
        background: var(--surface);
      }
    }
  }
</style>
