---
import type { MarkdownHeading } from "astro";
import type { Locale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  headings: MarkdownHeading[];
  locale: Locale;
}

const { headings, locale } = Astro.props;
const t = useTranslations(locale);
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <div class="toc" data-toc>
    <details open>
      <summary>
        <Icon name="list" size={16} />
        <span id="toc-title">{t("post.toc")}</span>
        <Icon name="chevron-down" size={16} class="chevron" />
      </summary>
      {/* The design system's contents: `contents()` marks the section being read. */}
      <nav class="x-toc" aria-labelledby="toc-title">
        {items.map((heading) => (
          <a href={`#${heading.slug}`} data-level={heading.depth === 3 ? "2" : undefined}>
            {heading.text}
          </a>
        ))}
      </nav>
    </details>
    <div class="progress" aria-hidden="true">
      <span />
    </div>
    <a class="top-link" href="#main">
      <Icon name="arrow-up" size={14} />
      {t("post.backToTop")}
    </a>
  </div>
)}

<script>
  import { contents } from "xantoom-design/extras.js";

  const toc = document.querySelector<HTMLElement>("[data-toc]");
  if (toc) {
    contents(toc);

    // In a sidebar taller than the window, the current link stays in view.
    const side = toc.closest<HTMLElement>(".side");
    if (side) {
      new MutationObserver((records) => {
        for (const { target } of records) {
          if (
            target instanceof HTMLElement &&
            target.getAttribute("aria-current") === "true" &&
            side.scrollHeight > side.clientHeight
          )
            target.scrollIntoView({ block: "nearest" });
        }
      }).observe(toc, { subtree: true, attributeFilter: ["aria-current"] });
    }

    // On wide screens the sidebar contents stay permanently open; on small screens they start folded.
    const details = toc.querySelector("details");
    const summary = toc.querySelector("summary");
    const wide = window.matchMedia("(min-width: 1100px)");
    const sync = () => {
      if (!details) return;
      details.open = wide.matches;
      if (summary) {
        if (wide.matches) summary.setAttribute("tabindex", "-1");
        else summary.removeAttribute("tabindex");
      }
    };
    wide.addEventListener("change", sync);
    sync();
    toc.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a") && !wide.matches && details) {
        details.open = false;
      }
    });
  }
</script>

<style>
  .toc {
    position: relative;
    font-size: 0.875rem;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--x-fg-faint);
    padding-block: 0.25rem 0.75rem;
    pointer-events: none;

    &::-webkit-details-marker {
      display: none;
    }

    & :global(.chevron) {
      display: none;
      margin-left: auto;
      transition: transform var(--x-duration-fast) var(--x-ease-out);
    }
  }

  /* Whole-article reading progress, only shown when scroll-driven animations are supported. */
  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      margin-top: 1.25rem;
      height: 0.1875rem;
      border-radius: 3px;
      background: var(--x-line);
      overflow: hidden;

      & span {
        display: block;
        height: 100%;
        background: var(--x-fill);
        transform-origin: left;
        transform: scaleX(0);
        animation: read-progress linear both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes read-progress {
    to {
      transform: scaleX(1);
    }
  }

  .top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--x-fg-faint);
    transition: color var(--x-duration-fast) var(--x-ease-out);

    &:hover {
      color: var(--x-fg);
    }
  }

  @media (max-width: 1099px) {
    .toc {
      border: 1px solid var(--x-line);
      border-radius: var(--x-radius-md);
      background: var(--x-surface);
      padding: 0.75rem 1rem;
    }

    summary {
      pointer-events: auto;
      padding-block: 0.125rem;

      & :global(.chevron) {
        display: block;
      }
    }

    details[open] summary {
      padding-bottom: 0.75rem;

      & :global(.chevron) {
        transform: rotate(180deg);
      }
    }

    .progress,
    .top-link {
      display: none;
    }
  }
</style>
