---
import type { MarkdownHeading } from "astro";
import type { Locale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  headings: MarkdownHeading[];
  locale: Locale;
}

const { headings, locale } = Astro.props;
const t = useTranslations(locale);
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <nav class="toc" aria-labelledby="toc-title" data-toc>
    <details open>
      <summary>
        <Icon name="list" size={16} />
        <span id="toc-title">{t("post.toc")}</span>
        <Icon name="chevron-down" size={16} class="chevron" />
      </summary>
      <ol>
        {items.map((heading) => (
          <li class:list={[`d${heading.depth}`]}>
            <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
    <div class="progress" aria-hidden="true">
      <span />
    </div>
    <a class="top-link" href="#main">
      <Icon name="arrow-up" size={14} />
      {t("post.backToTop")}
    </a>
  </nav>
)}

<script>
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  if (toc) {
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]").forEach((link) => {
      links.set(link.dataset.tocLink!, link);
    });

    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const side = toc.closest<HTMLElement>(".side");

    let current = "";
    const update = () => {
      const atBottom =
        window.scrollY > 0 &&
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
      let active = headings[0]?.id ?? "";
      if (atBottom && headings.length > 0) {
        active = headings[headings.length - 1]!.id;
      } else {
        const offset = window.innerHeight * 0.25;
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top - offset <= 0) active = heading.id;
          else break;
        }
      }
      if (active === current) return;
      links.get(current)?.removeAttribute("aria-current");
      const activeLink = links.get(active);
      activeLink?.setAttribute("aria-current", "location");
      if (activeLink && side && side.scrollHeight > side.clientHeight) {
        activeLink.scrollIntoView({ block: "nearest" });
      }
      current = active;
    };

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    update();

    // On wide screens the sidebar contents stay permanently open; on small screens they start folded.
    const details = toc.querySelector("details");
    const summary = toc.querySelector("summary");
    const wide = window.matchMedia("(min-width: 1100px)");
    const sync = () => {
      if (!details) return;
      details.open = wide.matches;
      if (summary) {
        if (wide.matches) summary.setAttribute("tabindex", "-1");
        else summary.removeAttribute("tabindex");
      }
    };
    wide.addEventListener("change", sync);
    sync();
    toc.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a") && !wide.matches && details) {
        details.open = false;
      }
    });
  }
</script>

<style>
  .toc {
    position: relative;
    font-size: 0.875rem;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg-faint);
    padding-block: 0.25rem 0.75rem;
    pointer-events: none;

    &::-webkit-details-marker {
      display: none;
    }

    & :global(.chevron) {
      display: none;
      margin-left: auto;
      transition: transform var(--dur-fast) var(--ease-out);
    }
  }

  ol {
    list-style: none;
    padding: 0 0 0 0.875rem;
    margin: 0;
    border-left: 1px solid var(--line);
  }

  li {
    margin: 0;
  }

  li.d3 {
    padding-left: 0.875rem;
  }

  ol a {
    position: relative;
    display: block;
    padding: 0.3125rem 0;
    color: var(--fg-muted);
    text-decoration: none;
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease-out);

    &::before {
      content: "";
      position: absolute;
      left: calc(-0.875rem - 1.5px);
      top: 0.25rem;
      bottom: 0.25rem;
      width: 2px;
      border-radius: 2px;
      background: var(--brand-gradient);
      opacity: 0;
      transform: scaleY(0.4);
      transition:
        opacity var(--dur-fast) var(--ease-out),
        transform var(--dur) var(--ease-out);
    }

    &:hover {
      color: var(--fg);
    }

    &[aria-current="location"] {
      color: var(--fg);
      font-weight: 550;

      &::before {
        opacity: 1;
        transform: scaleY(1);
      }
    }
  }

  li.d3 a::before {
    left: calc(-1.75rem - 1.5px);
  }

  /* Whole-article reading progress, only shown when scroll-driven animations are supported. */
  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      margin-top: 1.25rem;
      height: 0.1875rem;
      border-radius: 3px;
      background: var(--line);
      overflow: hidden;

      & span {
        display: block;
        height: 100%;
        background: var(--brand-gradient);
        transform-origin: left;
        transform: scaleX(0);
        animation: read-progress linear both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes read-progress {
    to {
      transform: scaleX(1);
    }
  }

  .top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--fg-faint);
    transition: color var(--dur-fast) var(--ease-out);

    &:hover {
      color: var(--fg);
    }
  }

  @media (max-width: 1099px) {
    .toc {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      padding: 0.75rem 1rem;
    }

    summary {
      cursor: pointer;
      pointer-events: auto;
      padding-block: 0.125rem;

      & :global(.chevron) {
        display: block;
      }
    }

    details[open] summary {
      padding-bottom: 0.75rem;

      & :global(.chevron) {
        transform: rotate(180deg);
      }
    }

    .progress,
    .top-link {
      display: none;
    }
  }
</style>
