---
import { homePath, localePath, LOCALES, type Locale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";
import { SITE } from "~/lib/site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, alternates = {} } = Astro.props;
const t = useTranslations(locale);
const other = LOCALES.find((l) => l !== locale)!;
const otherHref = alternates[other] ?? homePath(other);
const path = Astro.url.pathname;

const links = [
  { href: localePath(locale, "blog"), label: t("nav.blog") },
  { href: localePath(locale, "projects"), label: t("nav.projects") },
  { href: localePath(locale, "about"), label: t("nav.about") },
];
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={homePath(locale)} aria-label={`${SITE.name}, ${t("nav.home")}`}>
      <Logo />
      <span>xantoom</span>
    </a>

    <nav aria-label={t("nav.main")}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={path.startsWith(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <a class="lang" href={otherHref} hreflang={other} lang={other} title={t("lang.switch")}>
        <Icon name="globe" size={16} />
        <span>{t("lang.switchShort")}</span>
        <span class="sr-only">{t("lang.switch")}</span>
      </a>
      <ThemeToggle locale={locale} />
      <a class="gh" href={SITE.github} rel="me noopener" title={t("nav.github")}>
        <Icon name="github" label={t("nav.github")} />
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid transparent;
    animation: header-edge linear both;
    animation-timeline: scroll();
    animation-range: 0 80px;
  }

  @keyframes header-edge {
    to {
      border-bottom-color: var(--line);
      background: var(--bg);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.125rem;
    letter-spacing: -0.02em;

    & :global(.logo) {
      transition: transform var(--dur) var(--ease-out);
    }

    &:hover :global(.logo) {
      transform: rotate(-8deg) scale(1.04);
    }
  }

  nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg-muted);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);

    &:hover {
      color: var(--fg);
      background: var(--surface);
    }

    &[aria-current="page"] {
      color: var(--fg);
      background: var(--raised);
      box-shadow: var(--shadow);
    }
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .lang,
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding-inline: 10px;
    border-radius: 999px;
    text-decoration: none;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease-out);

    &:hover {
      color: var(--fg);
    }
  }

  @media (max-width: 720px) {
    .bar {
      flex-wrap: wrap;
      gap: 0 12px;
      padding-block: 10px 0;
    }

    nav {
      order: 3;
      width: 100%;
      margin-inline: -12px;
      padding-block: 6px 8px;
    }

    .gh {
      display: none;
    }
  }
</style>
