---
import { homePath, localePath, type Locale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";
import { SITE } from "~/lib/site";
import Icon from "./Icon.astro";
import LangMenu from "./LangMenu.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, alternates = {} } = Astro.props;
const t = useTranslations(locale);
const path = Astro.url.pathname;

const links = [
  { href: localePath(locale, "blog"), label: t("nav.blog") },
  { href: localePath(locale, "projects"), label: t("nav.projects") },
  { href: localePath(locale, "about"), label: t("nav.about") },
];
---

<header class="header">
  <div class="container bar">
    <a
      class="brand"
      href={homePath(locale)}
      aria-label={`${SITE.name}, ${t("nav.home")}`}
      aria-current={path === homePath(locale) ? "page" : undefined}
    >
      <Logo size={2} eager />
      <span>xantoom</span>
    </a>

    <nav aria-label={t("nav.main")}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={path.startsWith(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <LangMenu locale={locale} alternates={alternates} />
      <ThemeToggle locale={locale} />
      <a class="gh" href={SITE.github} rel="me noopener" title={t("nav.github")}>
        <Icon name="si:github" size={18} label={t("nav.github")} />
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    transition: opacity var(--dur-fast) var(--ease-out);

    &:hover {
      opacity: 0.82;
    }
  }

  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg-muted);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);

    &:hover {
      color: var(--fg);
      background: var(--surface);
    }

    &[aria-current="page"] {
      color: var(--fg);
      background: var(--raised);
      box-shadow: 0 0 0 1px var(--line);
    }
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }

  .gh {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    color: var(--fg-faint);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);

    &:hover {
      color: var(--fg);
      background: var(--surface);
    }
  }

  @media (max-width: 720px) {
    .bar {
      flex-wrap: wrap;
      gap: 0 0.75rem;
      min-height: auto;
      padding-block: 0.5rem 0;
    }

    nav {
      order: 3;
      width: 100%;
      margin-inline: -0.75rem;
      padding-block: 0.25rem 0.5rem;
    }
  }
</style>
