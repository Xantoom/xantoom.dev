---
/**
 * Icons from Iconify sets, inlined at build time (no runtime request).
 *   "arrow-right"   Lucide (interface icons, outline)
 *   "si:windows"    Simple Icons (brands, filled)
 *   "flag:fr"       Circle Flags (languages)
 * Decorative by default (aria-hidden); pass `label` to expose it.
 */
import { icons as flags } from "@iconify-json/circle-flags";
import { icons as lucide } from "@iconify-json/lucide";
import { icons as brands } from "@iconify-json/simple-icons";
import { getIconData, iconToSVG, replaceIDs } from "@iconify/utils";

interface Props {
  name: string;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 18, label, class: className } = Astro.props;
const [set, icon] = name.includes(":") ? name.split(":") : ["lucide", name];
const collection = { lucide, si: brands, flag: flags }[set as "lucide" | "si" | "flag"];
const data = collection && getIconData(collection, icon!);
if (!data) throw new Error(`Unknown icon "${name}"`);
const svg = iconToSVG(data);
// Unique ids per inlined copy (flags use masks), so two copies on a page never clash.
const body = replaceIDs(svg.body);
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  style={`--icon-size:${size / 16}rem`}
  viewBox={svg.attributes.viewBox}
  fill={set === "si" ? "currentColor" : undefined}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  set:html={body}
/>
