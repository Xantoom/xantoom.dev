---
import Icon from "../Icon.astro";
import { DEFAULT_LOCALE, isLocale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";

/**
 *   <Callout type="tip">Plafonner les FPS 3 images sous la fréquence de l'écran.</Callout>
 */
interface Props {
  type?: "note" | "tip" | "warning";
  title?: string;
}

const { type = "note", title } = Astro.props;
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);
const icon = { note: "info", tip: "lightbulb", warning: "triangle-alert" } as const;
---

<aside class:list={["callout", type]}>
  <p class="head">
    <Icon name={icon[type]} size={18} />
    <span>{title ?? t(`callout.${type}`)}</span>
  </p>
  <div class="content">
    <slot />
  </div>
</aside>

<style>
  .callout {
    --tone: var(--x-fg-muted);
    margin-block: 1.8em;
    padding: 1rem 1.25rem;
    border-radius: var(--x-radius-md);
    border: 1px solid color-mix(in srgb, var(--tone) 35%, var(--x-line));
    background: color-mix(in srgb, var(--tone) 7%, var(--x-surface));
  }

  .tip {
    --tone: var(--x-success);
  }

  .warning {
    --tone: var(--x-accent);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    color: var(--x-fg);
  }

  .head :global(.icon) {
    color: var(--tone);
  }

  .content {
    margin-top: 0.375rem;
    color: var(--x-fg);

    & > :global(* + *) {
      margin-top: 0.75em;
    }
  }
</style>
