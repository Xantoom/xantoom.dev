---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { DEFAULT_LOCALE, isLocale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";

/**
 * Optimized image with an optional caption (the design system's `x-figure`): the picture is a button that opens it
 * large in the shared `x-lightbox` dialog (src/lib/code-copy.ts).
 * Usage in MDX:
 *   import shot from "./shot.png";
 *   <Figure src={shot} alt="…" caption="…" />
 * Animated GIFs are better shipped as <Video gif /> (much lighter).
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** "wide" lets the figure expand past the reading column on large screens without touching the TOC. */
  size?: "column" | "wide";
}

const { src, alt, caption, size = "column" } = Astro.props;
const isGif = src.format === "gif";
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<figure class:list={["x-figure", "figure", size]}>
  <button type="button" data-figure-zoom aria-label={`${t("figure.zoom")}: ${alt}`}>
    {isGif ? (
      <img
        src={src.src}
        width={src.width}
        height={src.height}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Image
        src={src}
        alt={alt}
        widths={[480, 768, 1080, 1440]}
        sizes={
          size === "wide" ? "(max-width: 1100px) 100vw, 960px" : "(max-width: 760px) 100vw, 720px"
        }
        loading="lazy"
      />
    )}
  </button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: 2em;
  }

  .figure :global(img) {
    border: 1px solid var(--x-line);
    border-radius: var(--x-radius-md);
    background: var(--x-surface);
  }

  /* Expand rightwards on wide viewports so the figure never overlaps the left TOC sidebar. */
  @media (min-width: 1100px) {
    .wide {
      width: calc(100% + 5rem);
      max-width: calc(var(--x-size-container) - 18rem);
    }
  }
</style>
