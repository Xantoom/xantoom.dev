---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

/**
 * Optimized image with an optional caption.
 * Usage in MDX:
 *   import shot from "./shot.png";
 *   <Figure src={shot} alt="…" caption="…" />
 * Animated GIFs are better shipped as <Video gif /> (much lighter).
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** "wide" lets the figure overflow the reading column on large screens. */
  size?: "column" | "wide";
}

const { src, alt, caption, size = "column" } = Astro.props;
const isGif = src.format === "gif";
---

<figure class:list={["figure", size]}>
  {isGif ? (
    <img
      src={src.src}
      width={src.width}
      height={src.height}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={[480, 768, 1080, 1440]}
      sizes={
        size === "wide" ? "(max-width: 1100px) 100vw, 1000px" : "(max-width: 760px) 100vw, 720px"
      }
      loading="lazy"
    />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: 2em;
  }

  .figure :global(img) {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  @media (min-width: 1100px) {
    .wide {
      width: min(62.5rem, 100vw - 2 * var(--gutter));
      margin-left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
