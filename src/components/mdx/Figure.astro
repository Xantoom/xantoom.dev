---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { DEFAULT_LOCALE, isLocale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";
import Icon from "../Icon.astro";

/**
 * Optimized image with an optional caption and native dialog zoom.
 * Usage in MDX:
 *   import shot from "./shot.png";
 *   <Figure src={shot} alt="…" caption="…" />
 * Animated GIFs are better shipped as <Video gif /> (much lighter).
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** "wide" lets the figure expand past the reading column on large screens without touching the TOC. */
  size?: "column" | "wide";
}

const { src, alt, caption, size = "column" } = Astro.props;
const isGif = src.format === "gif";
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<figure class:list={["figure", size]}>
  <div class="frame">
    {isGif ? (
      <img
        src={src.src}
        width={src.width}
        height={src.height}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Image
        src={src}
        alt={alt}
        widths={[480, 768, 1080, 1440]}
        sizes={
          size === "wide" ? "(max-width: 1100px) 100vw, 960px" : "(max-width: 760px) 100vw, 720px"
        }
        loading="lazy"
      />
    )}
    <button
      type="button"
      class="figure-zoom"
      data-figure-zoom
      aria-label={t("figure.zoom")}
      title={t("figure.zoom")}
    >
      <Icon name="maximize-2" size={15} />
    </button>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: 2em;
  }

  .frame {
    position: relative;
  }

  .figure :global(img) {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .figure-zoom {
    position: absolute;
    right: 0.625rem;
    bottom: 0.625rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--raised) 92%, transparent);
    color: var(--fg-muted);
    opacity: 0;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);

    &:hover,
    &:focus-visible {
      opacity: 1;
      color: var(--fg);
    }
  }

  .frame:hover .figure-zoom {
    opacity: 1;
  }

  @media (hover: none) {
    .figure-zoom {
      opacity: 1;
    }
  }

  /* Expand rightwards on wide viewports so the figure never overlaps the left TOC sidebar. */
  @media (min-width: 1100px) {
    .wide {
      width: calc(100% + 5rem);
      max-width: calc(var(--container) - 18rem);
    }
  }
</style>
