---
import ProjectLogo from "../ProjectLogo.astro";
import { DEFAULT_LOCALE, isLocale } from "~/i18n/config";
import { getProjects, projectUrl } from "~/lib/content";

/**
 * Every app of the current locale: logo tile, name and tagline, tinted with its colours.
 *   <AppList />
 */
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const projects = await getProjects(locale);
---

<ul class="app-list">
  {projects.map((project) => (
    <li class="item" style={`--p-a:${project.data.colors[0]};--p-b:${project.data.colors[1]}`}>
      <a class="row" href={projectUrl(project)}>
        <span class="tile">
          <ProjectLogo logo={project.data.logo} size={28} />
        </span>
        <span class="text">
          <span class="name">{project.data.name}</span>
          <span class="tagline">{project.data.tagline}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .app-list {
    display: grid;
    gap: 0.625rem;
    padding: 0;
    list-style: none;
  }

  .app-list .item {
    margin: 0;
  }

  .app-list .row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    border: 1px solid color-mix(in srgb, var(--p-a) 30%, var(--line));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--p-a) 7%, var(--surface));
    color: var(--fg);
    font-weight: 400;
    line-height: 1.45;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);

    &:hover {
      border-color: color-mix(in srgb, var(--p-a) 60%, var(--line-strong));
      background: color-mix(in srgb, var(--p-a) 12%, var(--surface));
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
  }

  .tile {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1.5px solid transparent;
    border-radius: var(--radius-sm);
    background:
      linear-gradient(var(--raised), var(--raised)) padding-box,
      linear-gradient(135deg, var(--p-a), var(--p-b)) border-box;
  }

  .text {
    display: grid;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .tagline {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .app-list .row {
      transition: none;
    }
  }
</style>
