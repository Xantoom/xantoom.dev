---
import type { Locale } from "~/i18n/config";
import { labelValue, useTranslations } from "~/i18n/ui";
import Icon from "./Icon.astro";

/**
 * One button that cycles through system, opposite-of-OS, and the other explicit theme.
 * The visible icon follows <html data-theme> through CSS so it is right before any script runs.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const labels = {
  system: labelValue(t("theme.label"), t("theme.system"), locale),
  light: labelValue(t("theme.label"), t("theme.light"), locale),
  dark: labelValue(t("theme.label"), t("theme.dark"), locale),
};
---

<button
  class="theme"
  type="button"
  data-theme-toggle
  data-labels={JSON.stringify(labels)}
  aria-label={labels.system}
  title={labels.system}
>
  <Icon name="sun-moon" size={18} class="system" />
  <Icon name="sun" size={18} class="light" />
  <Icon name="moon" size={18} class="dark" />
  <span class="sr-only" aria-live="polite" data-theme-status></span>
</button>

<script>
  type Theme = "system" | "light" | "dark";
  const root = document.documentElement;
  const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");

  function current(): Theme {
    const value = root.dataset.theme;
    return value === "light" || value === "dark" ? value : "system";
  }

  /** From system, jump directly to the opposite theme so the first click always produces a visible change. */
  function nextTheme(state: Theme): Theme {
    const osDark = darkQuery.matches;
    const opposite: Theme = osDark ? "light" : "dark";
    const matching: Theme = osDark ? "dark" : "light";
    if (state === "system") return opposite;
    if (state === opposite) return matching;
    return "system";
  }

  function syncThemeColor(theme: Theme) {
    for (const meta of document.querySelectorAll<HTMLMetaElement>("meta[data-theme-color]")) {
      if (theme === "system") {
        meta.content = meta.dataset.themeColor === "dark" ? "#15161c" : "#ebebee";
      } else {
        meta.content = theme === "dark" ? "#15161c" : "#ebebee";
      }
    }
  }

  function apply(theme: Theme) {
    if (theme === "system") delete root.dataset.theme;
    else root.dataset.theme = theme;
    syncThemeColor(theme);
    try {
      if (theme === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", theme);
    } catch {
      /* storage unavailable: the choice lasts for this page only */
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const labels = JSON.parse(button.dataset.labels ?? "{}") as Record<Theme, string>;
    const status = button.querySelector<HTMLElement>("[data-theme-status]");
    const updateLabel = (announce: boolean) => {
      const text = labels[current()];
      button.setAttribute("aria-label", text);
      button.title = text;
      if (announce && status) status.textContent = text;
    };
    updateLabel(false);

    button.addEventListener("click", () => {
      apply(nextTheme(current()));
      updateLabel(true);
    });
  }
</script>

<style>
  .theme {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    color: var(--fg-faint);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);

    &:hover {
      background: var(--surface);
      color: var(--fg);
    }

    & :global(.icon) {
      grid-area: 1 / 1;
      opacity: 0;
      transform: translateY(0.1875rem) scale(0.88);
      transition:
        opacity var(--dur-fast) var(--ease-out),
        transform var(--dur-fast) var(--ease-out);
    }
  }

  :global(:root:not([data-theme])) .theme :global(.system),
  :global(:root[data-theme="light"]) .theme :global(.light),
  :global(:root[data-theme="dark"]) .theme :global(.dark) {
    opacity: 1;
    transform: none;
  }
</style>
