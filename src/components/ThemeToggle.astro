---
import type { Locale } from "~/i18n/config";
import { labelValue, useTranslations } from "~/i18n/ui";
import Icon from "./Icon.astro";

/**
 * The design system's theme switch (`.x-cycle`, wired by xantoom-design/theme.js): system, light, dark. The visible
 * icon is set before any script by the head script (BaseHead), which reads the same stored choice.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const labels = {
  system: labelValue(t("theme.label"), t("theme.system"), locale),
  light: labelValue(t("theme.label"), t("theme.light"), locale),
  dark: labelValue(t("theme.label"), t("theme.dark"), locale),
};
---

<button
  class="x-cycle"
  type="button"
  data-theme-toggle
  data-label-system={labels.system}
  data-label-light={labels.light}
  data-label-dark={labels.dark}
  aria-label={labels.system}
>
  <Icon name="sun-moon" size={18} data-v="system" />
  <Icon name="sun" size={18} data-v="light" />
  <Icon name="moon" size={18} data-v="dark" />
</button>
<script is:inline>
  // The current icon before the module below runs, so the button never shows empty.
  (() => {
    let theme = "system";
    try {
      theme = localStorage.getItem("x-theme") || "system";
    } catch {}
    const button = document.currentScript?.previousElementSibling;
    button?.querySelector(`[data-v="${theme}"]`)?.setAttribute("data-current", "");
  })();
</script>

<script>
  import { type ThemeChoice, themeCycle } from "xantoom-design/theme.js";

  /** The browser's bar follows the chosen theme; on system, each meta keeps its media query's colour. */
  function syncThemeColor(theme: ThemeChoice) {
    for (const meta of document.querySelectorAll<HTMLMetaElement>("meta[data-theme-color]")) {
      const scheme = theme === "system" ? meta.dataset.themeColor : theme;
      meta.content = scheme === "dark" ? "#15161c" : "#ebebee";
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    themeCycle(button, { onChange: syncThemeColor });
  }
</script>
