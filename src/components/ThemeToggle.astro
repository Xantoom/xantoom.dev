---
import type { Locale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";
import Icon from "./Icon.astro";

/**
 * One button that cycles system → light → dark. The visible icon follows the
 * <html data-theme> attribute through CSS, so it is right before any script runs.
 */
interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const labels = {
  system: t("theme.system"),
  light: t("theme.light"),
  dark: t("theme.dark"),
};
---

<button
  class="theme"
  type="button"
  data-theme-toggle
  data-labels={JSON.stringify(labels)}
  data-prefix={t("theme.label")}
  aria-label={`${t("theme.label")} : ${labels.system}`}
  title={`${t("theme.label")} : ${labels.system}`}
>
  <Icon name="sun-moon" size={18} class="system" />
  <Icon name="sun" size={18} class="light" />
  <Icon name="moon" size={18} class="dark" />
</button>

<script>
  const ORDER = ["system", "light", "dark"] as const;
  type Theme = (typeof ORDER)[number];
  const root = document.documentElement;

  function current(): Theme {
    const value = root.dataset.theme;
    return value === "light" || value === "dark" ? value : "system";
  }

  function apply(theme: Theme) {
    if (theme === "system") delete root.dataset.theme;
    else root.dataset.theme = theme;
    try {
      if (theme === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", theme);
    } catch {
      /* storage unavailable: the choice lasts for this page only */
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const labels = JSON.parse(button.dataset.labels ?? "{}") as Record<Theme, string>;
    const label = () => {
      const text = `${button.dataset.prefix} : ${labels[current()]}`;
      button.setAttribute("aria-label", text);
      button.title = text;
    };
    label();

    button.addEventListener("click", () => {
      const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length]!;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!document.startViewTransition || reduce) {
        apply(next);
        label();
        return;
      }

      // The new theme spreads in a circle from the button.
      const rect = button.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

      root.classList.add("theme-switching");
      const transition = document.startViewTransition(() => {
        apply(next);
        label();
      });
      transition.ready
        .then(() => {
          root.animate(
            { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
            {
              duration: 520,
              easing: "cubic-bezier(0.16, 1, 0.3, 1)",
              pseudoElement: "::view-transition-new(root)",
            },
          );
        })
        .catch(() => {});
      transition.finished.finally(() => root.classList.remove("theme-switching"));
    });
  }
</script>

<style>
  .theme {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--fg-faint);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);

    &:hover {
      background: var(--surface);
      color: var(--fg);
    }

    &:active :global(.icon) {
      scale: 0.9;
    }

    & :global(.icon) {
      grid-area: 1 / 1;
      opacity: 0;
      transform: rotate(-90deg) scale(0.5);
      filter: blur(2px);
      transition:
        opacity var(--dur) var(--ease-out),
        transform 480ms var(--ease-out),
        filter var(--dur) var(--ease-out),
        scale var(--dur-fast) var(--ease-out);
    }
  }

  /* The icon of the active choice turns in; the others wait rotated out. */
  :global(:root:not([data-theme])) .theme :global(.system),
  :global(:root[data-theme="light"]) .theme :global(.light),
  :global(:root[data-theme="dark"]) .theme :global(.dark) {
    opacity: 1;
    transform: none;
    filter: none;
  }
</style>
