---
import { localePath, type Locale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";
import { SITE } from "~/lib/site";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const rss = locale === "fr" ? "/rss.xml" : `/${locale}/rss.xml`;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <p class="note">
      © {year} {SITE.name}
    </p>
    <ul class="links">
      <li>
        <a href={localePath(locale, "legal")}>{t("footer.legal")}</a>
      </li>
      <li>
        <a href={localePath(locale, "privacy")}>{t("footer.privacy")}</a>
      </li>
      <li>
        <a href={rss} title={t("nav.rss")}>
          <Icon name="rss" size={16} label={t("nav.rss")} />
        </a>
      </li>
      <li>
        <a href={SITE.repo} rel="noopener" title={t("footer.source")}>
          <Icon name="si:github" size={16} label={t("footer.source")} />
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(4rem, 10vw, 7.5rem);
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--fg-faint);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.75rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.25rem;
    list-style: none;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--fg-muted);
    text-decoration: none;

    &:hover {
      color: var(--fg);
    }
  }
</style>
