---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <defs>
    <linearGradient id="xt-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ff5a2c" />
      <stop offset="1" stop-color="#ffae1a" />
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill="url(#xt-grad)" />
  <path
    d="M10 9.5 22 22.5M22 9.5l-4.6 5M14.6 17.5 10 22.5"
    stroke="#1a1009"
    stroke-width="3.2"
    stroke-linecap="round"
    fill="none"
  ></path>
</svg>
