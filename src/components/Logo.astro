---
import { Image } from "astro:assets";
import avatar from "~/assets/avatar.jpg";

/** Xantoom's avatar, used as the site logo. */
interface Props {
  /** Rendered size in rem. */
  size?: number;
  class?: string;
  eager?: boolean;
}

const { size = 2, class: className, eager = false } = Astro.props;
const px = Math.round(size * 16);
---

<Image
  src={avatar}
  alt=""
  width={px}
  height={px}
  densities={[1, 2, 3]}
  loading={eager ? "eager" : "lazy"}
  class:list={["logo", className]}
  style={`--logo-size:${size}rem`}
/>

<style>
  .logo {
    width: var(--logo-size);
    height: var(--logo-size);
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--x-fg) 12%, transparent);
  }
</style>
