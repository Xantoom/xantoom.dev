---
/** Renders a project's logo: the brand mark the design system ships (xantoom-design/brand/<logo>.svg). */
const files = import.meta.glob<string>("../../node_modules/xantoom-design/brand/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

interface Props {
  logo: string;
  size?: number;
}

const { logo, size = 40 } = Astro.props;
const source = files[`../../node_modules/xantoom-design/brand/${logo}.svg`];
if (!source) throw new Error(`No brand logo "${logo}" in xantoom-design/brand`);

// Frontmatter runs once per render: inlined SVGs share the document, so ids get a suffix and two copies never collide.
const suffix = `-${Math.random().toString(36).slice(2, 8)}`;
const svg = source
  .replace(/\sid="([^"]+)"/g, (_, id) => ` id="${id}${suffix}"`)
  .replace(/url\(#([^)]+)\)/g, (_, id) => `url(#${id}${suffix})`)
  .replace(/href="#([^"]+)"/g, (_, id) => `href="#${id}${suffix}"`)
  // Only the root <svg> gets resized: inner shapes keep their own width/height.
  .replace(/<svg\b[^>]*>/, (tag) =>
    tag
      .replace(/\s(width|height|role|aria-label)="[^"]*"/g, "")
      .replace(
        "<svg",
        `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"`,
      ),
  );
---

<span class="logo" set:html={svg} />

<style>
  .logo {
    display: inline-grid;
    place-items: center;
  }
</style>
