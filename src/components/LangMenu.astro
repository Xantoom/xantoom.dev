---
import { homePath, LOCALE_META, LOCALES, type Locale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";
import Icon from "./Icon.astro";

/**
 * Language picker: a flag button that opens a small menu (native popover,
 * so Escape and clicking outside close it without any script).
 */
interface Props {
  locale: Locale;
  /** URL of the current page in each locale; falls back to that locale's home. */
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, alternates = {} } = Astro.props;
const t = useTranslations(locale);
---

<div class="lang">
  <button
    class="trigger"
    type="button"
    popovertarget="lang-menu"
    aria-label={`${t("lang.label")} : ${LOCALE_META[locale].label}`}
    title={t("lang.label")}
  >
    <Icon name={`flag:${LOCALE_META[locale].flag}`} size={20} />
    <Icon name="chevron-down" size={14} class="chevron" />
  </button>

  <div id="lang-menu" class="menu" popover>
    <ul>
      {LOCALES.map((l) => (
        <li>
          <a
            href={alternates[l] ?? homePath(l)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? "true" : undefined}
          >
            <Icon name={`flag:${LOCALE_META[l].flag}`} size={20} />
            <span>{LOCALE_META[l].label}</span>
            {l === locale && <Icon name="check" size={16} class="current" />}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .trigger {
    anchor-name: --lang-trigger;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 2.25rem;
    padding-inline: 0.5rem 0.375rem;
    border-radius: 999px;
    color: var(--fg-faint);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);

    &:hover,
    &:has(+ .menu:popover-open) {
      background: var(--surface);
      color: var(--fg);
    }

    & :global(.icon:first-child) {
      border-radius: 50%;
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--fg) 14%, transparent);
    }

    & :global(.chevron) {
      transition: transform var(--dur) var(--ease-out);
    }

    &:has(+ .menu:popover-open) :global(.chevron) {
      transform: rotate(180deg);
    }
  }

  .menu {
    position-anchor: --lang-trigger;
    position-area: block-end span-inline-start;
    position-try-fallbacks: flip-inline;
    inset: auto;
    margin: 0.5rem 0 0;
    min-width: 11rem;
    padding: 0.375rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--raised);
    color: var(--fg);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 16px 40px -12px rgb(0 0 0 / 0.35);
    opacity: 0;
    transform: translateY(-0.25rem) scale(0.98);
    transform-origin: top right;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur) var(--ease-out),
      overlay var(--dur) allow-discrete,
      display var(--dur) allow-discrete;

    &:popover-open {
      opacity: 1;
      transform: none;

      @starting-style {
        opacity: 0;
        transform: translateY(-0.25rem) scale(0.98);
      }
    }
  }

  /* Browsers without anchor positioning: pin the menu under the header, right side. */
  @supports not (position-area: block-end) {
    .menu {
      position: fixed;
      top: calc(var(--header-h) - 0.25rem);
      right: var(--gutter);
    }
  }

  ul {
    list-style: none;
    padding: 0;
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;

    &:hover,
    &:focus-visible {
      background: var(--surface);
    }

    & :global(.icon:first-child) {
      border-radius: 50%;
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--fg) 14%, transparent);
    }
  }

  a[aria-current] {
    font-weight: 650;
  }

  .current {
    margin-left: auto;
    color: var(--accent);
  }
</style>
