---
import { homePath, LOCALE_META, LOCALES, type Locale } from "~/i18n/config";
import { labelValue, useTranslations } from "~/i18n/ui";
import Icon from "./Icon.astro";

/**
 * Language picker: a flag button that opens a small menu (native popover,
 * so Escape and clicking outside close it without any script).
 */
interface Props {
  locale: Locale;
  /** URL of the current page in each locale; falls back to that locale's home. */
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, alternates = {} } = Astro.props;
const t = useTranslations(locale);
---

<div class="lang">
  <button
    class="x-button trigger"
    data-variant="ghost"
    data-size="sm"
    type="button"
    popovertarget="lang-menu"
    aria-controls="lang-menu"
    aria-haspopup="true"
    aria-label={labelValue(t("lang.label"), LOCALE_META[locale].label, locale)}
    title={t("lang.label")}
  >
    <Icon name={`flag:${LOCALE_META[locale].flag}`} size={20} class="flag" />
    <Icon name="chevron-down" size={14} class="chevron" />
  </button>

  <nav id="lang-menu" class="x-menu menu" popover aria-label={t("lang.label")}>
    {LOCALES.map((l) => (
      <a
        class="x-menu-item"
        href={alternates[l] ?? homePath(l)}
        hreflang={l}
        lang={l}
        aria-current={l === locale ? "page" : undefined}
      >
        <Icon name={`flag:${LOCALE_META[l].flag}`} size={20} class="flag" />
        <span>{LOCALE_META[l].label}</span>
      </a>
    ))}
  </nav>
</div>

<style>
  /* The design system's ghost button and menu; only the anchoring and the flags are the site's. */
  .trigger {
    anchor-name: --lang-trigger;
    gap: 0.25rem;
    color: var(--x-fg-faint);

    &:has(+ .menu:popover-open) {
      color: var(--x-fg);
    }

    & :global(.chevron) {
      @media (prefers-reduced-motion: no-preference) {
        transition: rotate var(--x-duration-base) var(--x-ease-out);
      }
    }

    &:has(+ .menu:popover-open) :global(.chevron) {
      rotate: 180deg;
    }
  }

  .menu {
    position-anchor: --lang-trigger;
    position-area: block-end span-inline-start;
    min-inline-size: 11rem;
  }

  /* Browsers without anchor positioning: pin the menu under the header, right side. */
  @supports not (position-area: block-end) {
    .menu {
      position: fixed;
      inset: calc(var(--header-h) - 0.25rem) var(--gutter) auto auto;
      margin: 0;
    }
  }

  .lang :global(.flag) {
    border-radius: 50%;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--x-fg) 14%, transparent);
  }
</style>
