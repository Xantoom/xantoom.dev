---
import BaseHead, { type SeoProps } from "~/components/BaseHead.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import { LOCALE_META } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";

type Props = SeoProps;

const props = Astro.props;
const t = useTranslations(props.locale);
---

<!doctype html>
<html lang={LOCALE_META[props.locale].htmlLang}>
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body>
    <a class="x-skip-link" href="#main">
      {t("skip")}
    </a>
    <Header locale={props.locale} alternates={props.alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={props.locale} />
  </body>
</html>
