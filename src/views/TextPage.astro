---
import { getEntry, render } from "astro:content";
import AppList from "~/components/mdx/AppList.astro";
import { localePath, LOCALES, type Locale, type RouteKey } from "~/i18n/config";
import { formatDate, useTranslations } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import "~/styles/prose.css";

interface Props {
  locale: Locale;
  /** Entry name in src/content/pages/<locale>/ and the matching route key. */
  page: Extract<RouteKey, "about" | "legal" | "privacy">;
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);
const entry = await getEntry("pages", `${locale}/${page}`);
if (!entry) throw new Error(`Missing page content: src/content/pages/${locale}/${page}.md`);
const { Content } = await render(entry);
const alternates = Object.fromEntries(LOCALES.map((l) => [l, localePath(l, page)]));
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  alternates={alternates}
>
  <div class="container page">
    <header class="head">
      <h1>{entry.data.title}</h1>
      {entry.data.updatedDate && (
        <p class="updated">
          {t("post.updated")}{" "}
          <time datetime={entry.data.updatedDate.toISOString()}>
            {formatDate(entry.data.updatedDate, locale)}
          </time>
        </p>
      )}
    </header>
    <article class="prose doc">
      <Content components={{ AppList }} />
    </article>
  </div>
</BaseLayout>

<style>
  /* One centred reading column. */
  .page {
    max-width: calc(44rem + 2 * var(--gutter));
  }

  .head {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
    font-weight: 750;
  }

  /* Looser rhythm than articles: short sections, read in one go. */
  .doc {
    line-height: 1.8;

    & > :global(* + *) {
      margin-top: 1.5em;
    }

    & :global(h2) {
      margin-top: 3.5rem;
      padding-top: 2.5rem;
      font-size: 1.5rem;
    }

    & :global(h2 + *) {
      margin-top: 1.25rem;
    }

    & > :global(:first-child) {
      margin-top: 0;
    }

    & :global(li + li) {
      margin-top: 0.75em;
    }
  }

  .updated {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    color: var(--fg-faint);
  }
</style>
