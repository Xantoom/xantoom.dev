---
import { getCollection, render } from "astro:content";
import Icon from "~/components/Icon.astro";
import PostList from "~/components/PostList.astro";
import ProjectLogo from "~/components/ProjectLogo.astro";
import { localePath, type Locale } from "~/i18n/config";
import { formatDate, useTranslations } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { entryLocale, entrySlug, getPosts, projectUrl, type Project } from "~/lib/content";
import { latestRelease } from "~/lib/github";
import { PLATFORMS } from "~/lib/platforms";
import { SITE } from "~/lib/site";
import "~/styles/prose.css";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const locale: Locale = entryLocale(project);
const slug = entrySlug(project);
const t = useTranslations(locale);
const { Content } = await render(project);
const data = project.data;
const release = await latestRelease(data.repo);

const translations = await getCollection("projects", (p) => entrySlug(p) === slug);
const alternates = Object.fromEntries(translations.map((p) => [entryLocale(p), projectUrl(p)]));
const articles = (await getPosts(locale)).filter((post) => post.data.project === slug);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: data.name,
  description: data.description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: data.platforms.map((p) => PLATFORMS[p].en).join(", "),
  softwareVersion: release?.version,
  url: data.url ?? data.repo,
  license: data.license,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  author: { "@type": "Person", name: SITE.author, alternateName: SITE.handle, url: SITE.github },
  codeRepository: data.repo,
};
---

<BaseLayout
  title={`${data.name} · ${data.tagline}`}
  description={data.description}
  locale={locale}
  alternates={alternates}
  image={`/og/${locale}/projects/${slug}.png`}
  jsonLd={jsonLd}
>
  <div class="page" style={`--p-a:${data.colors[0]};--p-b:${data.colors[1]}`}>
    <header class="hero">
      <div class="container hero-inner">
        <a class="back" href={localePath(locale, "projects")}>
          <Icon name="arrow-left" size={16} />
          {t("project.all")}
        </a>
        <div class="id">
          <span class="mark">
            <ProjectLogo logo={data.logo} size={56} />
          </span>
          <div>
            <h1>{data.name}</h1>
            <p class="tagline">{data.tagline}</p>
          </div>
        </div>
        <div class="actions">
          {data.url && (
            <a class="primary" href={data.url} rel="noopener">
              {t("project.visit")} {new URL(data.url).host}
              <Icon name="arrow-up-right" size={16} />
            </a>
          )}
          {!data.url && release && (
            <a class="primary" href={release.url} rel="noopener">
              <Icon name="download" size={16} />
              {t("project.download")}
            </a>
          )}
          <a class="secondary" href={data.repo} rel="noopener">
            <Icon name="si:github" size={16} />
            {t("project.source")}
          </a>
        </div>
      </div>
    </header>

    <div class="container layout">
      <aside class="facts">
        <dl>
          {release && (
            <div>
              <dt>{t("project.release")}</dt>
              <dd>
                <a href={release.url} rel="noopener" class="mono">
                  v{release.version}
                </a>
                <span class="sub">{formatDate(release.date, locale, "short")}</span>
              </dd>
            </div>
          )}
          {data.status !== "stable" && (
            <div>
              <dt>{t("project.statusLabel")}</dt>
              <dd>
                <span class="status">{t(`project.status.${data.status}`)}</span>
              </dd>
            </div>
          )}
          <div>
            <dt>{t("project.platforms")}</dt>
            <dd class="platforms">
              {data.platforms.map((platform) => (
                <span>
                  <Icon name={PLATFORMS[platform].icon} size={16} />
                  {PLATFORMS[platform][locale]}
                </span>
              ))}
            </dd>
          </div>
          <div>
            <dt>{t("project.license")}</dt>
            <dd>{data.license}</dd>
          </div>
          <div>
            <dt>{t("project.stack")}</dt>
            <dd>
              <ul class="stack">
                {data.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
      </aside>

      <div class="main">
        <section aria-labelledby="features-title">
          <h2 id="features-title">{t("project.features")}</h2>
          <ul class="features">
            {data.features.map((feature) => (
              <li>
                <strong>{feature.title}</strong>
                {feature.text}
              </li>
            ))}
          </ul>
        </section>

        <article class="prose">
          <Content />
        </article>

        {articles.length > 0 && (
          <section class="articles" aria-labelledby="articles-title">
            <h2 id="articles-title">{t("project.articles")}</h2>
            <PostList posts={articles} locale={locale} headingLevel={3} />
          </section>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Header band tinted with the project's colours. */
  .hero {
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(
        60rem 22rem at 0% 0%,
        color-mix(in srgb, var(--p-a) 18%, transparent),
        transparent 70%
      ),
      radial-gradient(
        40rem 18rem at 100% 100%,
        color-mix(in srgb, var(--p-b) 10%, transparent),
        transparent 70%
      );
  }

  .hero-inner {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(2rem, 5vw, 3rem);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg-muted);
    transition: color var(--dur-fast) var(--ease-out);

    &:hover {
      color: var(--fg);
    }
  }

  .id {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.5rem);
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
  }

  .mark {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(4.5rem, 12vw, 6rem);
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 1.375rem;
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--p-a) 26%, transparent), transparent 70%),
      var(--raised);
    box-shadow: var(--shadow);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .tagline {
    margin-top: 0.25rem;
    max-width: 40rem;
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    color: var(--fg-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.75rem;

    & a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.625rem;
      padding-inline: 1.125rem;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.9375rem;
      transition:
        transform var(--dur) var(--ease-out),
        background-color var(--dur-fast) var(--ease-out),
        border-color var(--dur-fast) var(--ease-out);

      &:active {
        transform: scale(0.98);
      }
    }
  }

  .primary {
    background: var(--fg);
    color: var(--bg);

    &:hover {
      background: color-mix(in srgb, var(--fg) 85%, var(--p-a));
    }
  }

  .secondary {
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--fg);

    &:hover {
      border-color: color-mix(in srgb, var(--p-a) 50%, var(--line-strong));
    }
  }

  /* Facts on the side, content in the main column. */
  .layout {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .facts {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);

    & dl {
      display: grid;
      gap: 1.25rem;
    }

    & dt {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--fg-faint);
    }

    & dd {
      margin-top: 0.375rem;
      font-weight: 550;
    }

    & a:hover {
      color: var(--accent);
    }
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }

  .sub {
    margin-left: 0.5rem;
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--fg-faint);
  }

  .status {
    display: inline-block;
    padding: 0.0625rem 0.5rem;
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--fg-muted);
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;

    & span {
      display: inline-flex;
      align-items: center;
      gap: 0.4375rem;
    }
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0;
    list-style: none;

    & li {
      padding: 0.125rem 0.5rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: var(--surface);
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--fg-muted);
    }
  }

  h2 {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 0;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);

    & li {
      padding: 1rem 1.5rem 1rem 0;
      border-bottom: 1px solid var(--line);
      color: var(--fg-muted);
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    & strong {
      display: block;
      margin-bottom: 0.125rem;
      color: var(--fg);
      font-weight: 650;
    }

    & li::before {
      content: "";
      display: block;
      width: 1.25rem;
      height: 2px;
      margin-bottom: 0.75rem;
      border-radius: 1px;
      background: var(--p-a);
    }
  }

  .prose {
    margin-top: 2.5rem;
  }

  .articles {
    margin-top: 3.5rem;

    & h2 {
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .facts {
      position: static;
      padding: 1.25rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--surface);

      & dl {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
      }
    }
  }
</style>
