---
import { getCollection, render } from "astro:content";
import Icon from "~/components/Icon.astro";
import PostList from "~/components/PostList.astro";
import ProjectLogo from "~/components/ProjectLogo.astro";
import { localePath, type Locale } from "~/i18n/config";
import { formatDate, useTranslations } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { entryLocale, entrySlug, getPosts, projectUrl, type Project } from "~/lib/content";
import { latestRelease } from "~/lib/github";
import { PLATFORMS } from "~/lib/platforms";
import { SITE } from "~/lib/site";
import "~/styles/prose.css";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const locale: Locale = entryLocale(project);
const slug = entrySlug(project);
const t = useTranslations(locale);
const { Content } = await render(project);
const data = project.data;
const release = await latestRelease(data.repo);

const translations = await getCollection("projects", (p) => entrySlug(p) === slug);
const alternates = Object.fromEntries(translations.map((p) => [entryLocale(p), projectUrl(p)]));
const articles = (await getPosts(locale)).filter((post) => post.data.project === slug);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: data.name,
  description: data.description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: data.platforms.map((p) => PLATFORMS[p].en).join(", "),
  softwareVersion: release?.version,
  url: data.url ?? data.repo,
  license: data.license,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  author: { "@type": "Person", name: SITE.author, alternateName: SITE.handle, url: SITE.github },
  codeRepository: data.repo,
};
---

<BaseLayout
  title={`${data.name} · ${data.tagline}`}
  description={data.description}
  locale={locale}
  alternates={alternates}
  image={`/og/${locale}/projects/${slug}.png`}
  jsonLd={jsonLd}
>
  <div class="container page" style={`--p-a:${data.colors[0]};--p-b:${data.colors[1]}`}>
    <a class="back" href={localePath(locale, "projects")}>
      <Icon name="arrow-left" size={16} />
      {t("project.all")}
    </a>

    <header class="hero">
      <div class="mark">
        <ProjectLogo logo={data.logo} size={72} />
      </div>
      <div>
        <h1>{data.name}</h1>
        <p class="tagline">{data.tagline}</p>
        <p class="desc">{data.description}</p>
        <div class="actions">
          {data.url && (
            <a class="primary" href={data.url} rel="noopener">
              {t("project.visit")} {new URL(data.url).host}
              <Icon name="arrow-up-right" size={16} />
            </a>
          )}
          {!data.url && release && (
            <a class="primary" href={release.url} rel="noopener">
              <Icon name="download" size={16} />
              {t("project.download")}
            </a>
          )}
          <a class="secondary" href={data.repo} rel="noopener">
            <Icon name="si:github" size={16} />
            GitHub
          </a>
        </div>
      </div>
    </header>

    <dl class="facts">
      {release && (
        <div>
          <dt>
            <Icon name="tag" size={16} />
            {t("project.release")}
          </dt>
          <dd>
            <a href={release.url} rel="noopener" class="mono">
              v{release.version}
            </a>
            <span class="sub">{formatDate(release.date, locale, "short")}</span>
          </dd>
        </div>
      )}
      <div>
        <dt>
          <Icon name="monitor-smartphone" size={16} />
          {t("project.platforms")}
        </dt>
        <dd class="platforms">
          {data.platforms.map((platform) => (
            <span>
              <Icon name={PLATFORMS[platform].icon} size={16} />
              {PLATFORMS[platform][locale]}
            </span>
          ))}
        </dd>
      </div>
      <div>
        <dt>
          <Icon name="scale" size={16} />
          {t("project.license")}
        </dt>
        <dd class="mono">{data.license}</dd>
      </div>
      <div>
        <dt>
          <Icon name="code" size={16} />
          {t("project.stack")}
        </dt>
        <dd>{data.stack.join(" · ")}</dd>
      </div>
    </dl>

    <section class="features" aria-labelledby="features-title">
      <h2 id="features-title">{t("project.features")}</h2>
      <ul>
        {data.features.map((feature) => (
          <li>
            <Icon name="check" size={18} />
            <span set:html={feature} />
          </li>
        ))}
      </ul>
    </section>

    <article class="prose">
      <Content />
    </article>

    {articles.length > 0 && (
      <section class="articles" aria-labelledby="articles-title">
        <h2 id="articles-title">{t("project.articles")}</h2>
        <PostList posts={articles} locale={locale} headingLevel={3} />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .page {
    max-width: calc(61.25rem + 2 * var(--gutter));
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: clamp(2rem, 6vw, 4rem);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg-muted);
    text-decoration: none;

    &:hover {
      color: var(--fg);
    }
  }

  .hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.75rem;
    align-items: start;
    margin-top: 1.75rem;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 28px;
    border: 1px solid var(--line);
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--p-a) 30%, transparent), transparent 65%),
      linear-gradient(320deg, color-mix(in srgb, var(--p-b) 18%, transparent), transparent 60%),
      var(--raised);
    box-shadow: var(--shadow);
    animation: settle 800ms var(--ease-out) both;
  }

  @keyframes settle {
    from {
      transform: rotate(-8deg) scale(0.92);
      opacity: 0;
    }
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .tagline {
    margin-top: 0.375rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .desc {
    margin-top: 0.75rem;
    max-width: 60ch;
    color: var(--fg-muted);
    font-size: 1.0625rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;

    & a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      height: 2.625rem;
      padding-inline: 1.125rem;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.9375rem;
      text-decoration: none;
      transition:
        transform var(--dur) var(--ease-out),
        background-color var(--dur-fast) var(--ease-out),
        border-color var(--dur-fast) var(--ease-out);

      &:active {
        transform: scale(0.98);
      }
    }
  }

  .primary {
    background: var(--fg);
    color: var(--bg);

    &:hover {
      background: color-mix(in srgb, var(--fg) 85%, var(--p-a));
    }
  }

  .secondary {
    border: 1px solid var(--line-strong);
    color: var(--fg);

    &:hover {
      background: var(--surface);
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
    gap: 1px;
    margin-top: 3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--line);
    overflow: hidden;

    & div {
      padding: 1.125rem 1.25rem;
      background: var(--surface);
    }

    & dt {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8125rem;
      color: var(--fg-faint);
    }

    & dd {
      margin-top: 0.5rem;
      font-weight: 550;
    }

    & a {
      text-decoration: none;

      &:hover {
        color: var(--accent);
      }
    }
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }

  .sub {
    margin-left: 0.5rem;
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--fg-faint);
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;

    & span {
      display: inline-flex;
      align-items: center;
      gap: 0.4375rem;
    }
  }

  .features {
    margin-top: 4rem;

    & h2 {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }

    & ul {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
      gap: 1.25rem 3rem;
      padding: 0;
      list-style: none;
    }

    & li {
      display: flex;
      gap: 0.75rem;
      color: var(--fg-muted);
    }

    & li :global(.icon) {
      margin-top: 0.1875rem;
      color: var(--p-a);
    }

    & li :global(strong) {
      color: var(--fg);
      font-weight: 600;
    }
  }

  .prose {
    margin-top: 3rem;
  }

  .articles {
    margin-top: 4rem;

    & h2 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 640px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .mark {
      width: 6rem;
      height: 6rem;
      border-radius: 22px;
    }
  }
</style>
