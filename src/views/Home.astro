---
import Icon from "~/components/Icon.astro";
import Logo from "~/components/Logo.astro";
import PostList from "~/components/PostList.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import ProjectLogo from "~/components/ProjectLogo.astro";
import { homePath, localePath, LOCALES, type Locale } from "~/i18n/config";
import { formatDate, useTranslations } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPosts, getProjects, projectUrl } from "~/lib/content";
import { latestRelease } from "~/lib/github";
import { SITE } from "~/lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = (await getPosts(locale)).slice(0, 5);
const projects = await getProjects(locale);
const alternates = Object.fromEntries(LOCALES.map((l) => [l, homePath(l)]));
const rss = locale === "fr" ? "/rss.xml" : `/${locale}/rss.xml`;

// Most recent release across all apps, shown under the intro.
const releases = await Promise.all(
  projects.map(async (project) => ({ project, release: await latestRelease(project.data.repo) })),
);
const newest = releases
  .filter((r) => r.release)
  .toSorted((a, b) => b.release!.date.valueOf() - a.release!.date.valueOf())[0];

// Apps placed around the avatar: angle on the orbit, in degrees.
const orbit = [-38, 62, 172];

/** Side of the tile where its tooltip opens: above for the upper half, below otherwise. */
function side(angle: number): "top" | "bottom" {
  return Math.sin((angle * Math.PI) / 180) < 0 ? "top" : "bottom";
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  inLanguage: locale,
  author: { "@type": "Person", name: SITE.author, alternateName: SITE.handle, url: SITE.github },
};
---

<BaseLayout
  title={SITE.name}
  description={t("site.description")}
  locale={locale}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <section class="container hero">
    <div class="intro">
      <h1>{t("home.hello")}</h1>
      <p class="lede">{t("home.lede")}</p>

      <ul class="links">
        <li>
          <a href={SITE.github} rel="me noopener" title="GitHub">
            <Icon name="si:github" size={18} label="GitHub" />
          </a>
        </li>
        <li>
          <a href={rss} title={t("nav.rss")}>
            <Icon name="rss" size={18} label={t("nav.rss")} />
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} title={SITE.email}>
            <Icon name="mail" size={18} label={SITE.email} />
          </a>
        </li>
      </ul>

      {newest && (
        <a class="release" href={newest.release!.url} rel="noopener">
          <span class="pulse" aria-hidden="true" />
          <span>
            {t("home.newRelease")} <strong>{newest.project.data.name}</strong>{" "}
            <span class="mono">v{newest.release!.version}</span>
          </span>
          <span class="date">{formatDate(newest.release!.date, locale, "short")}</span>
          <Icon name="arrow-up-right" size={14} />
        </a>
      )}
    </div>

    <div class="orbit" aria-hidden="true">
      <div class="ring" />
      <div class="me">
        <Logo size={9} eager />
      </div>
      {releases.slice(0, orbit.length).map(({ project, release }, i) => (
        <a
          class="app"
          href={projectUrl(project)}
          tabindex="-1"
          data-side={side(orbit[i]!)}
          style={`--angle:${orbit[i]}deg;--delay:${120 + i * 90}ms;--p-a:${project.data.colors[0]}`}
        >
          <span class="tile">
            <ProjectLogo logo={project.data.logo} size={34} />
          </span>
          <span class="tip">
            <span class="tip-head">
              <strong>{project.data.name}</strong>
              {release && <span class="tip-version">v{release.version}</span>}
            </span>
            <span class="tip-text">{project.data.tagline}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="container block" aria-labelledby="apps-title">
    <div class="block-head">
      <h2 id="apps-title">{t("home.projects")}</h2>
      <a class="more" href={localePath(locale, "projects")}>
        {t("home.allProjects")}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <div class="bento">
      {projects.map((project, i) => (
        <ProjectCard project={project} locale={locale} large={i === 0} />
      ))}
    </div>
  </section>

  <section class="container block" aria-labelledby="posts-title">
    <div class="block-head">
      <h2 id="posts-title">{t("home.latest")}</h2>
      {posts.length > 0 && (
        <a class="more" href={localePath(locale, "blog")}>
          {t("home.allPosts")}
          <Icon name="arrow-right" size={16} />
        </a>
      )}
    </div>
    {posts.length > 0 ? (
      <PostList posts={posts} locale={locale} headingLevel={3} />
    ) : (
      <div class="empty">
        <Icon name="pen-line" size={22} />
        <p>{t("blog.none")}</p>
        <a href={rss}>
          <Icon name="rss" size={16} />
          {t("blog.follow")}
        </a>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: 3rem;
    padding-top: clamp(3rem, 8vw, 6.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
    /* Tooltips near the edge never widen the page. */
    overflow-x: clip;
  }

  h1 {
    font-size: clamp(2.5rem, 5.6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  .lede {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    line-height: 1.55;
    color: var(--fg-muted);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .links {
    display: flex;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
    animation: rise 600ms var(--ease-out) 100ms both;

    & a {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--surface);
      color: var(--fg-muted);
      transition:
        color var(--dur-fast) var(--ease-out),
        border-color var(--dur-fast) var(--ease-out),
        transform var(--dur) var(--ease-out);

      &:hover {
        color: var(--fg);
        border-color: var(--line-strong);
        transform: translateY(-2px);
      }
    }
  }

  .release {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.5rem;
    padding: 0.5rem 0.875rem 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--fg-muted);
    text-decoration: none;
    animation: rise 600ms var(--ease-out) 180ms both;
    transition: border-color var(--dur-fast) var(--ease-out);

    &:hover {
      border-color: var(--line-strong);
      color: var(--fg);
    }

    & strong {
      color: var(--fg);
      font-weight: 600;
    }

    & .mono {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
    }
  }

  .release > span {
    white-space: nowrap;
  }

  .date {
    color: var(--fg-faint);

    @media (max-width: 480px) {
      display: none;
    }
  }

  .pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 20%, transparent);
  }

  /* Avatar with the apps on an orbit around it. */
  .orbit {
    --size: 26rem;
    --orbit-r: calc(var(--size) / 2 - 2.25rem);
    position: relative;
    justify-self: center;
    width: var(--size);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .ring {
    position: absolute;
    inset: 2.25rem;
    border: 1px dashed var(--line-strong);
    border-radius: 50%;
    animation: fade 900ms var(--ease-out) both;
  }

  .ring::after {
    content: "";
    position: absolute;
    inset: 22%;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  @keyframes fade {
    from {
      opacity: 0;
      scale: 0.9;
    }
  }

  .me {
    position: relative;
    border-radius: 50%;
    box-shadow:
      0 0 0 0.5rem var(--bg),
      0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.45);
    animation: fade 900ms var(--ease-out) both;
  }

  /* Each app sits on the orbit: rotate to its angle, move out, rotate back upright. */
  .app {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4rem;
    height: 4rem;
    margin: -2rem 0 0 -2rem;
    transform: rotate(var(--angle)) translateX(var(--orbit-r)) rotate(calc(-1 * var(--angle)));
    animation: launch 1100ms var(--ease-out) var(--delay) both;

    &:hover {
      z-index: 2;
    }
  }

  /* Apps leave from behind the avatar and travel along the orbit to their place.
     Only transform and opacity change, so the compositor runs it. */
  @keyframes launch {
    from {
      transform: rotate(calc(var(--angle) - 140deg)) translateX(0)
        rotate(calc(140deg - var(--angle)));
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
  }

  .tile {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 1.125rem;
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--p-a) 22%, transparent), transparent 70%),
      var(--raised);
    box-shadow: var(--shadow);
    transition:
      scale var(--dur) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);

    .app:hover & {
      scale: 1.08;
      border-color: color-mix(in srgb, var(--p-a) 60%, var(--line));
    }
  }

  /* Tooltip: opens on the side facing away from the avatar. */
  .tip {
    --shift-y: 0;
    position: absolute;
    display: grid;
    gap: 0.25rem;
    padding: 0.625rem 0.875rem 0.75rem;
    border: 1px solid var(--line);
    border-top: 2px solid var(--p-a);
    border-radius: var(--radius);
    background: var(--raised);
    box-shadow: var(--shadow);
    text-align: left;
    pointer-events: none;
    opacity: 0;
    translate: 0 var(--shift-y);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      translate var(--dur) var(--ease-out);

    .app:hover & {
      opacity: 1;
      translate: 0 0;
      transition-delay: 60ms;
    }

    [data-side="top"] & {
      bottom: calc(100% + 0.75rem);
      left: 50%;
      margin-left: -7.5rem;
      width: 15rem;
      --shift-y: 0.375rem;
    }

    [data-side="bottom"] & {
      top: calc(100% + 0.75rem);
      left: 50%;
      margin-left: -7.5rem;
      width: 15rem;
      --shift-y: -0.375rem;
    }
  }

  .tip-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--fg);
    font-size: 0.9375rem;
  }

  .tip-version {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-faint);
  }

  .tip-text {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--fg-muted);
  }

  /* No hover on touch screens: the tiles are plain links there. */
  @media (hover: none) {
    .tip {
      display: none;
    }
  }

  .block {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  h2 {
    font-size: 1.75rem;
    letter-spacing: -0.025em;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);

    & :global(.icon) {
      transition: transform var(--dur) var(--ease-out);
    }

    &:hover {
      color: var(--accent);
    }

    &:hover :global(.icon) {
      transform: translateX(3px);
    }
  }

  /* First app large on the left, the others stacked on the right. */
  .bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;

    & > :global(.large) {
      grid-row: span 2;
    }
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    padding: 2rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    color: var(--fg-muted);

    & a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 500;
      color: var(--accent);

      &:hover {
        color: var(--accent-hover);
      }
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .orbit {
      --size: 19rem;
      grid-row: 1;
    }

    .bento {
      grid-template-columns: 1fr;

      & > :global(.large) {
        grid-row: auto;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app {
      animation: none;
    }

    .tip {
      translate: none;
      transition: opacity var(--dur-fast) linear;
    }
  }
</style>
