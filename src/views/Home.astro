---
import Logo from "~/components/Logo.astro";
import PostList from "~/components/PostList.astro";
import ProjectLogo from "~/components/ProjectLogo.astro";
import { homePath, localePath, LOCALES, type Locale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPosts, getProjects, projectUrl } from "~/lib/content";
import { latestRelease } from "~/lib/github";
import { PLATFORMS } from "~/lib/platforms";
import { SITE } from "~/lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = (await getPosts(locale)).slice(0, 5);
const projects = await getProjects(locale);
const alternates = Object.fromEntries(LOCALES.map((l) => [l, homePath(l)]));
const rss = locale === "fr" ? "/rss.xml" : `/${locale}/rss.xml`;

// Apps placed around the avatar: angle on the orbit in degrees (0 is right, 90 is down).
const angles = [-40, 42, 180];

// Each app on the orbit: its place, and a short second line (version, status or platform).
const apps = await Promise.all(
  projects.slice(0, angles.length).map(async (project, i) => {
    const release = await latestRelease(project.data.repo);
    const angle = angles[i]!;
    const meta = release
      ? `v${release.version}`
      : project.data.status !== "stable"
        ? t(`project.status.${project.data.status}`)
        : PLATFORMS[project.data.platforms[0]!][locale];
    return {
      project,
      angle,
      meta,
      side: Math.cos((angle * Math.PI) / 180) < 0 ? "left" : "right",
    };
  }),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  inLanguage: locale,
  author: { "@type": "Person", name: SITE.author, url: SITE.github },
};
---

<BaseLayout
  title={SITE.name}
  description={t("site.description")}
  locale={locale}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <section class="container hero">
    <nav class="orbit" aria-label={t("nav.projects")}>
      <div class="ring" aria-hidden="true"></div>
      <div class="me">
        <Logo size={13} eager />
      </div>
      <ul>
        {apps.map(({ project, angle, meta, side }, i) => (
          <li
            class="app"
            data-side={side}
            style={`--angle:${angle}deg;--delay:${160 + i * 110}ms;--p-a:${project.data.colors[0]}`}
          >
            <a href={projectUrl(project)}>
              <span class="tile">
                <ProjectLogo logo={project.data.logo} size={48} />
              </span>
              <span class="legend">
                <span class="name">{project.data.name}</span>
                <span class="meta">{meta}</span>
                <span class="more">
                  <span>{project.data.tagline}</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <h1>{t("home.hello")}</h1>
  </section>

  <section class="container posts" aria-labelledby="posts-title">
    <div class="posts-head">
      <h2 id="posts-title">{t("home.latest")}</h2>
      {posts.length > 0 && <a href={localePath(locale, "blog")}>{t("home.allPosts")}</a>}
    </div>
    {posts.length > 0 ? (
      <PostList posts={posts} locale={locale} headingLevel={3} />
    ) : (
      <p class="empty">
        {t("blog.none")} <a href={rss}>{t("blog.follow")}</a>
      </p>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    justify-items: center;
    padding-top: clamp(0.5rem, 2vw, 1.5rem);
  }

  /* The avatar with the apps on an orbit around it. Everything scales from --size;
     no percentages, because --size also feeds the transforms of the tiles. */
  .orbit {
    /* Large, but the heading under it stays in the first screen. */
    --size: clamp(22rem, 100svh - 19rem, 34rem);
    --tile: calc(var(--size) * 0.155);
    --inset: calc(var(--tile) * 0.55);
    --avatar: calc(var(--size) * 0.38);
    --orbit-r: calc(var(--size) / 2 - var(--inset));
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    aspect-ratio: 1;

    & ul {
      display: contents;
      list-style: none;
    }
  }

  .ring {
    position: absolute;
    inset: var(--inset);
    border: 1px dashed var(--line-strong);
    border-radius: 50%;
    animation: appear 900ms var(--ease-out) both;
  }

  .ring::after {
    content: "";
    position: absolute;
    inset: 22%;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .me {
    border-radius: 50%;
    box-shadow:
      0 0 0 0.625rem var(--bg),
      0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.45);
    animation: appear 900ms var(--ease-out) both;

    & :global(.logo) {
      width: var(--avatar);
      height: var(--avatar);
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
      scale: 0.92;
    }
  }

  /* Each app sits on the orbit: rotate to its angle, move out, rotate back upright. */
  .app {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--tile);
    height: var(--tile);
    margin: calc(var(--tile) / -2) 0 0 calc(var(--tile) / -2);
    transform: rotate(var(--angle)) translateX(var(--orbit-r)) rotate(calc(-1 * var(--angle)));
    animation: launch 1100ms var(--ease-out) var(--delay) both;

    &:hover,
    &:focus-within {
      z-index: 2;
    }

    & a {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: calc(var(--tile) * 0.28);
    }

    & a:focus-visible {
      outline: none;
    }
  }

  /* The apps leave from behind the avatar and travel along the orbit to their place:
     the page's one entrance. Only transform and opacity change. */
  @keyframes launch {
    from {
      transform: rotate(calc(var(--angle) - 140deg)) translateX(0)
        rotate(calc(140deg - var(--angle)));
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
  }

  .tile {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: inherit;
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--p-a) 22%, transparent), transparent 70%),
      var(--raised);
    box-shadow: var(--shadow);
    transition:
      scale var(--dur) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);

    & :global(svg) {
      width: calc(var(--tile) * 0.58);
      height: calc(var(--tile) * 0.58);
    }

    a:hover &,
    a:focus-visible & {
      scale: 1.06;
      border-color: var(--p-a);
    }

    a:focus-visible & {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
  }

  /* Name and version written next to each tile, on the side away from the avatar.
     The one-line description opens under them on hover or keyboard focus. */
  .legend {
    position: absolute;
    top: 50%;
    display: grid;
    width: 14rem;
    translate: 0 -1.5rem;
    animation: label-in 500ms var(--ease-out) calc(var(--delay) + 700ms) both;

    [data-side="right"] & {
      left: calc(100% + 1rem);
    }

    [data-side="left"] & {
      right: calc(100% + 1rem);
      text-align: right;
    }
  }

  @keyframes label-in {
    from {
      opacity: 0;
    }
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--fg);
  }

  .meta {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--fg-faint);
  }

  .more {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);

    & span {
      overflow: hidden;
      padding-top: 0.375rem;
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--fg-muted);
    }

    a:hover &,
    a:focus-visible & {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }

  h1 {
    max-width: 40rem;
    margin-top: clamp(0.5rem, 2vw, 1.25rem);
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .posts {
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  .posts-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1.25rem;

    & h2 {
      font-size: 1.5rem;
      letter-spacing: -0.02em;
    }

    & a {
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--fg-muted);
      transition: color var(--dur-fast) var(--ease-out);

      &:hover {
        color: var(--accent);
      }
    }
  }

  .empty {
    padding-block: 1.25rem;
    border-block: 1px solid var(--line);
    color: var(--fg-muted);

    & a {
      font-weight: 550;
      color: var(--accent);

      &:hover {
        color: var(--accent-hover);
      }
    }
  }

  /* Without room on the sides, names go under the tiles and the description stays
     on the app page. */
  @media (max-width: 68rem) {
    .orbit {
      --size: min(30rem, 100vw - 2 * var(--gutter) - 2rem);
      margin-bottom: 2.5rem;
    }

    .legend {
      top: calc(100% + 0.5rem);
      left: 50%;
      width: max-content;
      translate: -50% 0;
      text-align: center;

      [data-side="right"] &,
      [data-side="left"] & {
        left: 50%;
        right: auto;
        text-align: center;
      }
    }

    .name {
      font-size: 0.9375rem;
    }

    .meta {
      font-size: 0.75rem;
    }

    .more {
      display: none;
    }
  }

  /* Wide screens: the orbit on the left, the sentence on the right. The orbit's sides
     keep room for the names (--legend-room), so they never run into the text. */
  @media (min-width: 75rem) {
    .hero {
      --legend-room: 9rem;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      justify-items: start;
      column-gap: var(--legend-room);
      padding-left: var(--legend-room);
      padding-top: clamp(1rem, 3vw, 2.5rem);
    }

    .orbit {
      --size: max(24rem, min(32rem, 100svh - 9rem, 100vw - 46rem));
    }

    .legend {
      width: calc(var(--legend-room) - 1rem);
    }

    h1 {
      max-width: 30rem;
      margin-top: 0;
      font-size: clamp(1.75rem, 2.2vw, 2.25rem);
      line-height: 1.25;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app,
    .legend {
      animation: none;
    }

    .more {
      transition: opacity var(--dur-fast) linear;
    }
  }
</style>
