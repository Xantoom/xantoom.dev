---
import Icon from "~/components/Icon.astro";
import Logo from "~/components/Logo.astro";
import PostList from "~/components/PostList.astro";
import ProjectLogo from "~/components/ProjectLogo.astro";
import { homePath, localePath, LOCALES, type Locale } from "~/i18n/config";
import { useTranslations } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPosts, getProjects, projectUrl } from "~/lib/content";
import { latestRelease } from "~/lib/github";
import { PLATFORMS } from "~/lib/platforms";
import { SITE } from "~/lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = (await getPosts(locale)).slice(0, 5);
const projects = await getProjects(locale);
const alternates = Object.fromEntries(LOCALES.map((l) => [l, homePath(l)]));
const rss = locale === "fr" ? "/rss.xml" : `/${locale}/rss.xml`;
// Intro sentence split on **…**: odd parts are the words set in bold.
const hello = t("home.hello").split("**");

// Apps placed around the avatar: angle on the orbit in degrees (0 is right, 90 is down).
const angles = [-38, 40, 180];
const hasMoreApps = projects.length > angles.length;

// Each app on the orbit: its place, and a short second line (version, status or platform).
const apps = await Promise.all(
  projects.slice(0, angles.length).map(async (project, i) => {
    const release = await latestRelease(project.data.repo);
    const angle = angles[i]!;
    const meta = release
      ? `v${release.version}`
      : project.data.status !== "stable"
        ? t(`project.status.${project.data.status}`)
        : PLATFORMS[project.data.platforms[0]!][locale];
    return {
      project,
      angle,
      meta,
      side: Math.cos((angle * Math.PI) / 180) < 0 ? "left" : "right",
    };
  }),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  inLanguage: locale,
  author: { "@type": "Person", name: SITE.author, url: SITE.github },
};
---

<BaseLayout
  title={SITE.name}
  description={t("site.description")}
  locale={locale}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <section class="container hero">
    <nav class="orbit" aria-label={t("nav.projects")}>
      <div class="ring" aria-hidden="true"></div>
      <div class="me">
        <Logo size={13} eager />
      </div>
      <ul>
        {apps.map(({ project, angle, meta, side }, i) => (
          <li
            class="app"
            data-side={side}
            style={`--angle:${angle}deg;--delay:${60 + i * 70}ms;--p-a:${project.data.colors[0]};--p-b:${project.data.colors[1]}`}
          >
            <a href={projectUrl(project)}>
              <span class="tile">
                <ProjectLogo logo={project.data.logo} size={44} />
              </span>
              <span class="legend">
                <span class="head-line">
                  <span class="name">{project.data.name}</span>
                  <span class="meta">{meta}</span>
                </span>
                <span class="more">
                  <span>{project.data.tagline}</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="intro">
      <h1>{hello.map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}</h1>
      {hasMoreApps && (
        <a class="all-apps" href={localePath(locale, "projects")}>
          {t("home.allApps")}
          <Icon name="arrow-right" size={16} />
        </a>
      )}
    </div>
  </section>

  <section class="container posts" aria-labelledby="posts-title">
    <div class="posts-head">
      <h2 id="posts-title">{t("home.latest")}</h2>
      {posts.length > 0 && <a href={localePath(locale, "blog")}>{t("home.allPosts")}</a>}
    </div>
    {posts.length > 0 ? (
      <PostList posts={posts} locale={locale} headingLevel={3} />
    ) : (
      <p class="empty">
        {t("blog.none")} <a href={rss}>{t("blog.follow")}</a>
      </p>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    justify-items: center;
    padding-top: clamp(1rem, 3vw, 2.25rem);
  }

  /* Avatar with apps placed on a refined hairline gradient orbit. */
  .orbit {
    --size: clamp(19rem, 34vw, 26rem);
    --tile: calc(var(--size) * 0.165);
    --inset: calc(var(--tile) * 0.55);
    --avatar: calc(var(--size) * 0.38);
    --orbit-r: calc(var(--size) / 2 - var(--inset));
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    aspect-ratio: 1;

    & ul {
      display: contents;
      list-style: none;
      padding: 0;
    }
  }

  /* Hairline ring, brand gradient all the way round. */
  .ring {
    position: absolute;
    inset: var(--inset);
    border-radius: 50%;
    padding: 1.5px;
    background: conic-gradient(from 315deg, var(--x-fill-1), var(--x-fill-3) 50%, var(--x-fill-1));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
  }

  .me {
    border-radius: 50%;
    padding: 0.25rem;
    background: var(--x-bg);
    box-shadow: 0 0 0 1px var(--x-line);

    & :global(.logo) {
      width: var(--avatar);
      height: var(--avatar);
      box-shadow: none;
    }
  }

  .app {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--tile);
    height: var(--tile);
    margin: calc(var(--tile) / -2) 0 0 calc(var(--tile) / -2);
    transform: rotate(var(--angle)) translateX(var(--orbit-r)) rotate(calc(-1 * var(--angle)));
    animation: settle 420ms var(--x-ease-out) var(--delay) both;

    &:hover,
    &:focus-within {
      z-index: 2;
    }

    & a {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: calc(var(--tile) * 0.26);
    }

    & a:focus-visible {
      outline: none;
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      scale: 0.9;
    }
  }

  .tile {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1.5px solid transparent;
    border-radius: inherit;
    background:
      linear-gradient(var(--x-raised), var(--x-raised)) padding-box,
      linear-gradient(
          135deg,
          color-mix(in srgb, var(--p-a) 42%, var(--x-line)),
          color-mix(in srgb, var(--p-b) 32%, var(--x-line))
        )
        border-box;
    box-shadow: var(--x-shadow-md);
    transition:
      scale var(--x-duration-fast) var(--x-ease-out),
      background var(--x-duration-fast) var(--x-ease-out);

    & :global(svg) {
      width: calc(var(--tile) * 0.56);
      height: calc(var(--tile) * 0.56);
    }

    a:hover &,
    a:focus-visible & {
      scale: 1.05;
      background:
        linear-gradient(var(--x-raised), var(--x-raised)) padding-box,
        linear-gradient(135deg, var(--p-a), var(--p-b)) border-box;
    }

    a:focus-visible & {
      outline: 2px solid var(--x-accent);
      outline-offset: 3px;
    }
  }

  /* Name and version next to each tile; tagline expands cleanly on hover or keyboard focus. */
  .legend {
    position: absolute;
    top: 50%;
    display: grid;
    width: 10.5rem;
    translate: 0 -1.35rem;
    animation: fade-in 320ms var(--x-ease-out) calc(var(--delay) + 120ms) both;

    [data-side="right"] & {
      left: calc(100% + 0.875rem);
    }

    [data-side="left"] & {
      right: calc(100% + 0.875rem);
      text-align: right;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  .head-line {
    display: grid;
  }

  .name {
    font-family: var(--x-font-sans);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--x-fg);
  }

  .meta {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--x-fg-faint);
  }

  .more {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows var(--x-duration-base) var(--x-ease-out),
      opacity var(--x-duration-fast) var(--x-ease-out);

    & span {
      overflow: hidden;
      padding-top: 0.3125rem;
      font-size: 0.8125rem;
      line-height: 1.45;
      color: var(--x-fg-muted);
    }

    a:hover &,
    a:focus-visible & {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }

  .intro {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-top: clamp(0.75rem, 2.5vw, 1.5rem);
  }

  h1 {
    max-width: 42rem;
    font-family: var(--x-font-sans);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: -0.005em;
    text-align: center;
    text-wrap: pretty;
    color: var(--x-fg-muted);

    & strong {
      font-weight: 650;
      color: var(--x-fg);
    }
  }

  .all-apps {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 550;
    color: var(--x-accent);
    transition: color var(--x-duration-fast) var(--x-ease-out);

    &:hover {
      color: var(--x-accent-hover);
    }
  }

  .posts {
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }

  .posts-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1.25rem;

    & h2 {
      font-size: 1.375rem;
      letter-spacing: -0.02em;
    }

    & a {
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--x-fg-muted);
      transition: color var(--x-duration-fast) var(--x-ease-out);

      &:hover {
        color: var(--x-accent);
      }
    }
  }

  .empty {
    padding-block: 1.25rem;
    border-block: 1px solid var(--x-line);
    color: var(--x-fg-muted);

    & a {
      font-weight: 550;
      color: var(--x-accent);

      &:hover {
        color: var(--x-accent-hover);
      }
    }
  }

  /* Mobile: avatar + heading, then a clean stack of app rows with visible taglines and zero overflow. */
  @media (max-width: 48rem) {
    .hero {
      gap: 1.5rem;
      padding-top: 1.5rem;
    }

    .orbit {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 1.5rem;
      width: 100%;
      aspect-ratio: auto;

      & ul {
        display: grid;
        gap: 0.625rem;
        width: 100%;
      }
    }

    .ring {
      display: none;
    }

    .me {
      padding: 2px;
      background: var(--x-fill);
      box-shadow: none;

      & :global(.logo) {
        width: 5.5rem;
        height: 5.5rem;
        border: 3px solid var(--x-bg);
      }
    }

    .intro {
      order: -1;
      margin-top: 0;
    }

    .app {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      transform: none;
      animation: none;

      & a {
        position: relative;
        display: grid;
        grid-template-columns: 3rem minmax(0, 1fr);
        align-items: center;
        gap: 0.875rem;
        padding: 0.875rem 1rem;
        border: 1px solid var(--x-line);
        border-radius: var(--x-radius-md);
        background: var(--x-surface);
        overflow: hidden;
        transition:
          border-color var(--x-duration-fast) var(--x-ease-out),
          background-color var(--x-duration-fast) var(--x-ease-out);

        &::before {
          content: "";
          position: absolute;
          inset: 0 auto 0 0;
          width: 3px;
          background: linear-gradient(180deg, var(--p-a), var(--p-b));
        }

        &:hover {
          border-color: color-mix(in srgb, var(--p-a) 45%, var(--x-line-strong));
          background: var(--x-raised);
        }

        &:focus-visible {
          outline: 2px solid var(--x-accent);
          outline-offset: 2px;
        }
      }
    }

    .tile {
      width: 3rem;
      height: 3rem;
      border-radius: var(--x-radius-sm);
      box-shadow: none;

      & :global(svg) {
        width: 1.625rem;
        height: 1.625rem;
      }

      a:hover &,
      a:focus-visible & {
        scale: none;
        outline: none;
      }
    }

    .legend {
      position: static;
      width: auto;
      translate: none;
      animation: none;

      [data-side="left"] &,
      [data-side="right"] & {
        left: auto;
        right: auto;
        text-align: left;
      }
    }

    .head-line {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.625rem;
    }

    .more {
      grid-template-rows: 1fr;
      opacity: 1;

      & span {
        padding-top: 0.1875rem;
      }
    }
  }

  /* Wide screens: orbit on the left with generous legend room, intro on the right. */
  @media (min-width: 75rem) {
    .hero {
      --legend-room: 10.5rem;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      justify-items: start;
      column-gap: calc(var(--legend-room) + 1rem);
      padding-left: calc(var(--gutter) + var(--legend-room));
      padding-top: clamp(1.5rem, 3.5vw, 3rem);
    }

    .orbit {
      --size: clamp(22rem, min(28rem, 100svh - 14rem, 100vw - 52rem), 28rem);
    }

    .legend {
      width: calc(var(--legend-room) - 0.5rem);
    }

    .intro {
      justify-items: start;
      margin-top: 0;
    }

    h1 {
      max-width: 34rem;
      font-size: clamp(1.0625rem, 1.15vw, 1.1875rem);
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app,
    .legend {
      animation: none;
    }

    .more {
      transition: opacity var(--x-duration-fast) linear;
    }
  }
</style>
