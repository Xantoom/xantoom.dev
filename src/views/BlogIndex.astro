---
import Icon from "~/components/Icon.astro";
import PostList from "~/components/PostList.astro";
import { localePath, LOCALES, type Locale } from "~/i18n/config";
import { categoryLabel, CATEGORY_KEYS, useTranslations } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPosts } from "~/lib/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await getPosts(locale);
const used = CATEGORY_KEYS.filter((key) => posts.some((post) => post.data.category === key));
const alternates = Object.fromEntries(LOCALES.map((l) => [l, localePath(l, "blog")]));
const rss = locale === "fr" ? "/rss.xml" : `/${locale}/rss.xml`;
const countLabel = (n: number) => `${n} ${n === 1 ? t("blog.count.one") : t("blog.count.other")}`;
---

<BaseLayout
  title={t("blog.title")}
  description={t("blog.description")}
  locale={locale}
  alternates={alternates}
>
  <div class="container">
    <header class="head">
      <h1>{t("blog.title")}</h1>
      <p class="lede">{t("blog.description")}</p>
      <a class="rss" href={rss}>
        <Icon name="rss" size={16} />
        RSS
      </a>
    </header>

    {posts.length === 0 ? (
      <p class="empty">{t("blog.none")}</p>
    ) : (
      <>
        <div class="controls" data-blog-controls>
          {used.length > 1 && (
            <div class="chips" role="group" aria-label={t("blog.filters")}>
              <button type="button" aria-pressed="true" data-category="all">
                {t("blog.filterAll")}
              </button>
              {used.map((key) => (
                <button type="button" aria-pressed="false" data-category={key}>
                  {categoryLabel(key, locale)}
                </button>
              ))}
            </div>
          )}
          <label class="search">
            <Icon name="search" size={16} />
            <span class="sr-only">{t("blog.searchLabel")}</span>
            <input type="search" placeholder={t("blog.search")} autocomplete="off" />
          </label>
          <p
            class="count"
            aria-live="polite"
            data-count
            data-one={t("blog.count.one")}
            data-other={t("blog.count.other")}
          >
            {countLabel(posts.length)}
          </p>
        </div>

        <PostList posts={posts} locale={locale} lead filterable />
        <div class="empty-box" data-empty hidden>
          <p>{t("blog.empty")}</p>
          <button type="button" class="reset" data-reset>
            {t("blog.reset")}
          </button>
        </div>
      </>
    )}
  </div>
</BaseLayout>

<script>
  const controls = document.querySelector<HTMLElement>("[data-blog-controls]");
  /** Lowercase without accents, so « reglage » matches « Réglage ». */
  const normalize = (value: string) => value.toLowerCase().normalize("NFD").replace(/\p{M}/gu, "");
  const list = document.querySelector<HTMLElement>("[data-post-list]");

  if (controls && list) {
    const items = [...list.querySelectorAll<HTMLElement>("li")];
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>("button[data-category]")];
    const input = controls.querySelector<HTMLInputElement>("input")!;
    const count = controls.querySelector<HTMLElement>("[data-count]")!;
    const empty = document.querySelector<HTMLElement>("[data-empty]")!;
    const resetBtn = empty.querySelector<HTMLButtonElement>("[data-reset]");

    const validCategories = new Set(buttons.map((b) => b.dataset.category ?? "all"));
    let category = "all";

    const syncButtons = () => {
      for (const button of buttons) {
        button.setAttribute(
          "aria-pressed",
          String((button.dataset.category ?? "all") === category),
        );
      }
    };

    const syncUrl = () => {
      const params = new URLSearchParams();
      if (category !== "all") params.set("category", category);
      const q = input.value.trim();
      if (q) params.set("q", q);
      const query = params.toString();
      const target = query ? `${window.location.pathname}?${query}` : window.location.pathname;
      history.replaceState(null, "", target);
    };

    const apply = (updateHistory = true) => {
      const query = normalize(input.value.trim());
      let visible = 0;
      for (const item of items) {
        const matchCategory = category === "all" || item.dataset.category === category;
        const matchQuery = !query || normalize(item.dataset.search ?? "").includes(query);
        item.hidden = !(matchCategory && matchQuery);
        if (!item.hidden) visible++;
      }
      // The lead layout only makes sense on the unfiltered list.
      list.classList.toggle("filtered", category !== "all" || query !== "");
      empty.hidden = visible > 0;
      count.textContent = `${visible} ${visible === 1 ? count.dataset.one : count.dataset.other}`;
      if (updateHistory) syncUrl();
    };

    // Restore filters from URL (?category=...&q=...) so Back navigation and category links work.
    const initial = new URLSearchParams(window.location.search);
    const initialCategory = initial.get("category");
    if (initialCategory && validCategories.has(initialCategory)) {
      category = initialCategory;
      syncButtons();
    }
    const initialQuery = initial.get("q");
    if (initialQuery) input.value = initialQuery;
    if (category !== "all" || initialQuery) apply(false);

    for (const button of buttons) {
      button.addEventListener("click", () => {
        category = button.dataset.category ?? "all";
        syncButtons();
        apply();
      });
    }
    input.addEventListener("input", () => apply());
    resetBtn?.addEventListener("click", () => {
      category = "all";
      input.value = "";
      syncButtons();
      apply();
      input.focus();
    });
  }
</script>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.75rem 2rem;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: 2rem;
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
    font-weight: 750;
  }

  .lede {
    grid-column: 1;
    max-width: 52ch;
    color: var(--fg-muted);
    font-size: 1.0625rem;
  }

  .rss {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--fg-muted);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);

    &:hover {
      color: var(--accent);
      background: var(--surface);
    }
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 0.5rem;
    padding-bottom: 1.25rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .chips button {
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--fg-muted);
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);

    &:hover {
      color: var(--fg);
      border-color: var(--line-strong);
    }

    &[aria-pressed="true"] {
      background: var(--fg);
      border-color: var(--fg);
      color: var(--bg);
    }
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 13.75rem;
    max-width: 21.25rem;
    height: 2.375rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--fg-faint);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);

    &:focus-within {
      border-color: var(--accent);
      background: var(--raised);
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    & input {
      flex: 1;
      min-width: 0;
      border: 0;
      background: none;
      outline: none;
      color: var(--fg);

      &::placeholder {
        color: var(--fg-faint);
      }
    }
  }

  .count {
    margin-left: auto;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--fg-faint);
  }

  .empty,
  .empty-box {
    padding: 2.5rem 0;
    color: var(--fg-muted);
  }

  .empty-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .empty-box[hidden] {
    display: none;
  }

  .reset {
    padding: 0.4375rem 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--fg);
    font-size: 0.875rem;
    font-weight: 550;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);

    &:hover {
      border-color: var(--accent);
      background: var(--raised);
    }
  }

  @media (max-width: 640px) {
    .head {
      grid-template-columns: 1fr;
    }

    .rss {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
      margin-left: -0.625rem;
    }

    .search {
      max-width: none;
    }

    .count {
      margin-left: 0;
    }
  }
</style>
